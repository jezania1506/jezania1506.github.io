---
import Card from "@components/atoms/display/Card.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";

const pageTitle = "Kontak";
const pageDescription = "Informasi kontak Jezania Tallia Palangda.";
---

<MainGridLayout
    title={pageTitle}
    description={pageDescription}
    page="contact"
>
    <div class="flex w-full rounded-[var(--shape-corner-l)] overflow-hidden relative">
        <Card
            color="var(--card-bg)"
            radius="l"
            class="z-10 p-6 lg:p-8 relative w-full"
        >
            <h1 class="text-2xl font-bold mb-4">Hubungi Saya</h1>

            <p class="mb-6">
                Terima kasih telah mengunjungi portofolio saya.
                Silakan hubungi saya melalui informasi berikut.
            </p>

            <div class="mb-6">
                <h2 class="text-lg font-semibold mb-2">Email</h2>
                <a href="mailto:jezaniaeza1506@gmail.com">
                    jezaniaeza1506@gmail.com
                </a>
            </div>

            <div>
                <h2 class="text-lg font-semibold mb-2">GitHub</h2>
                <a
                    href="https://github.com/jezania1506"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    github.com/jezania1506
                </a>
            </div>
        </Card>
    </div>
</MainGridLayout>